# Copy this file to .env and fill in what you need.
# Leave LLM_PROVIDER=mock to run the whole app with zero API keys.

COMPASS_LLM_PROVIDER=mock          # mock | anthropic | openai
COMPASS_ANTHROPIC_API_KEY=
COMPASS_OPENAI_API_KEY=
COMPASS_LLM_MODEL=claude-sonnet-4-6
COMPASS_ENVIRONMENT=development
